import { useEffect, useState } from "react";
import CartItemRow from "../components/CartItemRow";

const BACK = import.meta.env.VITE_BACK_URL || "https://senda-suds-backend-m4s7.onrender.com";

export default function Cart() {
  const [cart, setCart] = useState({ items: [], total_cents: 0 });
  const [loading, setLoading] = useState(true);
  const token = localStorage.getItem("token");

  useEffect(() => {
    let mounted = true;
    (async () => {
      try {
        const r = await fetch(`${BACK}/api/cart/`, {
          headers: token ? { Authorization: `Bearer ${token}` } : {},
          credentials: "omit",
        });
        if (!r.ok) throw new Error(`HTTP ${r.status}`);
        const data = await r.json();
        if (mounted) setCart(data);
      } catch (e) {
        console.error("Error cargando carrito:", e);
        if (mounted) setCart({ items: [], total_cents: 0 });
      } finally {
        if (mounted) setLoading(false);
      }
    })();
    return () => { mounted = false; };
  }, [token]);

  const formatPrice = (cents) =>
    new Intl.NumberFormat("es-ES", { style: "currency", currency: "EUR" })
      .format((cents ?? 0) / 100);

  return (
    <div className="max-w-3xl mx-auto p-4">
      <h1 className="text-xl font-semibold mb-4">Tu carrito</h1>

      {loading ? (
        <div className="text-gray-500">Cargando…</div>
      ) : cart.items?.length ? (
        <>
          <ul className="divide-y">
            {cart.items.map((it, idx) => (
              <CartItemRow
                key={it.id ?? it.product_id ?? idx}
                item={it}
                onRemove={null}  // reemplaza por tu handler si ya lo tienes
              />
            ))}
          </ul>
          <div className="text-right mt-4 font-bold">
            Total: {formatPrice(cart.total_cents)}
          </div>
        </>
      ) : (
        <div className="text-gray-500">Tu carrito está vacío.</div>
      )}
    </div>
  );
}
